# Todas opcionais para rodar localmente.

# URL pública do site (metadados/OG). Padrão: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Redis (Vercel KV) — contador de partidas em /api/played. Sem ele, o contador é ignorado.
KV_REDIS_URL=

# Chave de acesso ao painel /plays?key=... — sem ela o painel responde 404.
PLAYS_KEY=

# Meta Pixel (opcional): id público e token para ler estatísticas no painel.
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
