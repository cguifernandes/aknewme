# Todas opcionais para rodar localmente.

# URL pública do site (metadados/OG). Padrão: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Redis (Vercel KV) — contador de partidas em /api/played. Sem ele, o contador é ignorado.
KV_REDIS_URL=

# Chave de acesso ao painel /plays?key=... — sem ela o painel responde 404.
PLAYS_KEY=

# Meta Pixel (opcional): id público e token para ler estatísticas no painel.
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=

# Login opcional e duelo com amigos (specs/login-duelo). Sem elas, as rotas de conta respondem 503 e o resto do site segue igual.
# Banco Neon (string pooled, com sslmode=require)
DATABASE_URL=
# Assinatura da sessão (gere com: npx auth secret)
AUTH_SECRET=
# Apps OAuth: Google Cloud Console e Discord Developer Portal
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
