    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.5.2",
