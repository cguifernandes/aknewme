    "ads": "node --experimental-strip-types --no-warnings scripts/ads.mjs",
    "plays": "node --env-file=.env.local scripts/plays.mjs",
    "build": "next build",
    "start": "next start",
    "check:data": "node --experimental-strip-types --no-warnings scripts/check-data.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --experimental-strip-types --no-warnings scripts/check-replay.mjs && node --experimental-strip-types --no-warnings scripts/check-streak.mjs && node --experimental-strip-types --no-warnings scripts/check-catalog.mjs && node --experimental-strip-types --no-warnings scripts/check-hl.mjs && node --experimental-strip-types --no-warnings scripts/check-handle.mjs && node --experimental-strip-types --no-warnings scripts/check-pagination.mjs && node --experimental-strip-types --no-warnings scripts/check-live.mjs && node --experimental-strip-types --no-warnings scripts/check-races.mjs"
